        },
    },
    /// Raw 16-bit data from REG58H (MSB) and REG59H (LSB) for ACIN Current ADC.
    /// The actual 12-bit ADC value is (REG58H << 4) | (REG59H & 0x0F).
    /// Use driver helper: Current (mA) = adc_value * 0.625.
    register AcinCurrentAdc {
        address: 0x58,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 16-bit data from REG5AH (MSB) and REG5BH (LSB) for VBUS Voltage ADC.
    /// The actual 12-bit ADC value is (REG5AH << 4) | (REG5BH & 0x0F).
    /// Use driver helper: Voltage (mV) = adc_value * 1.7.
    register VbusVoltageAdc {
        address: 0x5A,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 16-bit data from REG5CH (MSB) and REG5DH (LSB) for VBUS Current ADC.
    /// The actual 12-bit ADC value is (REG5CH << 4) | (REG5DH & 0x0F).
    /// Use driver helper: Current (mA) = adc_value * 0.375.
    register VbusCurrentAdc {
        address: 0x5C,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 16-bit data from REG5EH (MSB) and REG5FH (LSB) for Internal Temperature ADC.
    /// The actual 12-bit ADC value is (REG5EH << 4) | (REG5FH & 0x0F).
    /// Use driver helper: Temp (°C) = (adc_value * 0.1) - 144.7.
    register InternalTemperatureAdc {
        address: 0x5E,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 16-bit data from REG62H (MSB) and REG63H (LSB) for TS Pin ADC.
    /// The actual 12-bit ADC value is (REG62H << 4) | (REG63H & 0x0F).
    /// Use driver helper: Voltage (mV) = adc_value * 0.8.
    register TsPinAdc {
        address: 0x62,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 16-bit data for GPIO Pin ADC (indexed 0-3).
    /// The actual 12-bit ADC value is (MSB_byte << 4) | (LSB_byte & 0x0F).
    /// Use driver helper: Voltage (mV) = adc_value * 0.5.
    register GpioVoltageAdc[4 stride 2] {
        address: 0x64,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 24-bit data from REG70H (MSB), REG71H, REG72H (LSB) for Battery Power ADC.
    /// The value is (REG70H << 16) | (REG71H << 8) | REG72H.
    /// Use driver helper: Power (uW) = adc_value * 0.55.
    register BatteryInstantaneousPowerAdc {
        address: 0x70,
        access: RO,
        fields: fieldset _ {
            size-bytes: 3,
        
            /// Raw 24-bit value. Use driver helper for actual power.
            field raw 23:0,
        },
    },
    /// Raw 16-bit data from REG78H (MSB) and REG79H (LSB) for Battery Voltage ADC.
    /// The actual 12-bit ADC value is (REG78H << 4) | (REG79H & 0x0F).
    /// Use driver helper: Voltage (mV) = adc_value * 1.1.
    register BatteryVoltageAdc {
        address: 0x78,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 16-bit data from REG7AH (MSB) and REG7BH (LSB) for Battery Charge Current ADC.
    /// The actual 13-bit ADC value is (REG7AH << 5) | (REG7BH & 0x1F).
    /// Use driver helper: Current (mA) = adc_value * 0.5.
    register BatteryChargeCurrentAdc {
        address: 0x7A,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 16-bit data from REG7CH (MSB) and REG7DH (LSB) for Battery Discharge Current ADC.
    /// The actual 13-bit ADC value is (REG7CH << 5) | (REG7DH & 0x1F).
    /// Use driver helper: Current (mA) = adc_value * 0.5.
    register BatteryDischargeCurrentAdc {
        address: 0x7C,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 16-bit data from REG7EH (MSB) and REG7FH (LSB) for APS Voltage ADC.
    /// The actual 12-bit ADC value is (REG7EH << 4) | (REG7FH & 0x0F).
    /// Use driver helper: Voltage (mV) = adc_value * 1.4.
    register ApsVoltageAdc {
        address: 0x7E,
        access: RO,
        fields: fieldset _ {
            size-bytes: 2,
        
            /// Raw 16-bit value. Use driver helper for actual ADC value.
            field raw 15:0,
        },
    },
    /// Raw 32-bit data for the battery charge coulomb counter.
    /// The value is (REG_B0 << 24) | (REG_B1 << 16) | (REG_B2 << 8) | REG_B3.
    /// Represents accumulated charge input.
    register BatteryChargeCoulombCounter {
        address: 0xB0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 4,
        
            /// Raw 32-bit unsigned accumulated charge count.
            field raw 31:0,
        },
    },
    /// Raw 32-bit data for the battery discharge coulomb counter.
    /// The value is (REG_B4 << 24) | (REG_B5 << 16) | (REG_B6 << 8) | REG_B7.
    /// Represents accumulated charge output.
    register BatteryDischargeCoulombCounter {
        address: 0xB4,
        access: RO,
        fields: fieldset _ {
            size-bytes: 4,
        
            /// Raw 32-bit unsigned accumulated discharge count.
            field raw 31:0,
        },
    },
    /// Controls the operation of the fuel gauge / coulomb counter, including enabling,
    /// pausing, and clearing its value.
    register CoulombCounterControl {
        address: 0xB8,
        reset: 0x00,
        fields: fieldset _ {
            size-bytes: 1,
        
            /// Coulomb counter enable (true: enabled, false: disabled).
            field coulomb_counter_enable 7,
            /// Request to pause the coulomb counter (true: pause, bit auto-clears; false: no action).
            field coulomb_counter_pause_request 6,
            /// Request to clear the coulomb counter (true: clear, bit auto-clears; false: no action).
            field coulomb_counter_clear_request 5,
        },
    },
}
